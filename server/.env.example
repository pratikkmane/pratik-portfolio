# MongoDB connection string
MONGO_URI=

# Private visitor counter (both optional; the counter still records without them)
# Push notifications: install the ntfy app and subscribe to this topic. Make it unguessable.
NTFY_TOPIC=
# Secret for GET /api/visit/stats?key=... Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
STATS_KEY=
